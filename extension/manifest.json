{
  "manifest_version": 3,
  "name": "LifeLensIQ Tracker",
  "version": "0.6.8",
  "key": "",
  "description": "Passive browser activity tracker for LifeLensIQ personal analytics (prototype). Focus mode, pomodoro, YouTube distraction-free.",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "notifications",
    "identity"
  ],
  "oauth2": {
    "client_id": "1056805592677-0qcgu4ofef41tref8nrvtm8pgfn7663p.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "openid"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LifeLensIQ Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content-shorts.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://docs.google.com/*",
        "*://*.office.com/*",
        "*://*.live.com/*",
        "*://*.onedrive.com/*"
      ],
      "js": [
        "content-writing.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content-youtube-focus.js",
        "content-youtube-title-watcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}