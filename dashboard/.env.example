# Copy this file to `.env` (same folder) and fill in the values from:
# Firebase Console -> Project settings -> General -> Your apps -> (web app) -> SDK setup & configuration
#
# Leave it empty to run the dashboard in DEMO MODE with local sample data
# (no Firebase account required, you can preview the whole UI and try exports).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=